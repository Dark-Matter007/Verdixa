MYSQL_DATABASE=leetcode_platform
MYSQL_USER=algosphere
MYSQL_PASSWORD=change-me-for-local-development
MYSQL_ROOT_PASSWORD=change-me-for-local-development
ALGOSPHERE_DB_URL=jdbc:mysql://localhost:3306/leetcode_platform
ALGOSPHERE_DB_USERNAME=root
ALGOSPHERE_DB_PASSWORD=your-local-mysql-password
ALGOSPHERE_JWT_SECRET=replace-with-a-random-32-plus-character-local-secret
ALGOSPHERE_BOOTSTRAP_ADMIN_USERNAME=
ALGOSPHERE_BOOTSTRAP_ADMIN_PASSWORD=
ALGOSPHERE_CPP_COMMAND=C:\\msys64\\ucrt64\\bin\\g++.exe
ALGOSPHERE_RUNTIME_PATH=C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin
ALGOSPHERE_PYTHON_COMMAND=python
VITE_API_BASE_URL=http://localhost:8080/api

# Public browser origin for certificate verification links in PDFs
VERDIXA_PUBLIC_BASE_URL=http://localhost:5173

# Email is disabled by default so local development never sends mail accidentally.
# Set MAIL_ENABLED=true only with a real TLS-capable SMTP provider; never commit real credentials.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Verdixa
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Set true temporarily when configuring SMTP to fail fast if the connection cannot authenticate.
MAIL_TEST_CONNECTION=false
FRONTEND_BASE_URL=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
ASSESSMENT_REMINDER_MINUTES=10
ASSESSMENT_REMINDER_OFFSET_MINUTES=1440,30
# OAuth credentials are backend-only. Configure matching callback URLs in Google/GitHub.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
OAUTH2_FRONTEND_SUCCESS_URL=http://localhost:5173/oauth/callback
OAUTH2_FRONTEND_FAILURE_URL=http://localhost:5173/oauth/error
APP_TIME_ZONE=UTC

# Server-only Gemini configuration. Never prefix these with VITE_ and never commit a real key.
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional DeepL Translation (server-side only). Keep the key out of browser/Vite variables.
DEEPL_ENABLED=false
DEEPL_API_KEY=
DEEPL_API_URL=https://api-free.deepl.com

# Generate a 32-byte key and store it as Base64. Never reuse the example or commit a real key.
VERIFICATION_STORAGE_PATH=./private-data/verification
VERIFICATION_STORAGE_KEY=
VERIFICATION_DOCUMENT_RETENTION_DAYS=30

ASSESSMENT_HEARTBEAT_SECONDS=10
ASSESSMENT_HEARTBEAT_TIMEOUT_SECONDS=40
CONTEST_REMINDER_MINUTES=10
NOTIFICATION_SCHEDULER_MS=60000
