MYSQL_DATABASE=leetcode_platform
MYSQL_USER=algosphere
MYSQL_PASSWORD=change-me-for-local-development
MYSQL_ROOT_PASSWORD=change-me-for-local-development
ALGOSPHERE_DB_URL=jdbc:mysql://localhost:3306/leetcode_platform
ALGOSPHERE_DB_USERNAME=root
ALGOSPHERE_DB_PASSWORD=your-local-mysql-password
ALGOSPHERE_JWT_SECRET=replace-with-a-random-32-plus-character-local-secret
ALGOSPHERE_BOOTSTRAP_ADMIN_USERNAME=
ALGOSPHERE_BOOTSTRAP_ADMIN_PASSWORD=
ALGOSPHERE_CPP_COMMAND=C:\\msys64\\ucrt64\\bin\\g++.exe
ALGOSPHERE_RUNTIME_PATH=C:\\msys64\\ucrt64\\bin;C:\\msys64\\usr\\bin
ALGOSPHERE_PYTHON_COMMAND=python
VITE_API_BASE_URL=http://localhost:8080/api

# Public browser origin for certificate verification links in PDFs
VERDIXA_PUBLIC_BASE_URL=http://localhost:5173

# Email is disabled by default so local development never sends mail accidentally.
# Set MAIL_ENABLED=true only with a real TLS-capable SMTP provider; never commit real credentials.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Verdixa
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Set true temporarily when configuring SMTP to fail fast if the connection cannot authenticate.
MAIL_TEST_CONNECTION=false
FRONTEND_BASE_URL=http://localhost:5173
APP_TIME_ZONE=UTC
